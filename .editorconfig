root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# S1133: "Do not forget to remove this deprecated code someday."
# This library deprecates public API with [Obsolete] before removing it in a major
# version, which is exactly what the attribute is for. The rule only reminds us that
# the members are still there, so it has nothing to report on a build.
dotnet_diagnostic.S1133.severity = none
